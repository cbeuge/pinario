# Vorlage. Kopieren nach .env, dort die echten Werte eintragen.
# .env steht in .gitignore und gehört auf dem Server www-data mit chmod 600.

# 1 auf dem Server, leer lassen auf dem Entwicklungsrechner. Steht es auf 1,
# bricht der Start ab, wenn unten etwas Wichtiges fehlt, und das Sitzungs-
# Cookie wird auf "nur über HTTPS" gesetzt.
PRODUKTION=

# Zufällig, mindestens 32 Zeichen:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Lokal über einen SSH-Tunnel auf den Server, weil Postgres dort nur auf
# localhost hört:
#   ssh -L 5433:127.0.0.1:5432 root@5.75.232.101
# Dann hier Port 5433 eintragen. Auf dem Server selbst 5432.
DATABASE_URL=postgresql+psycopg://pinario:PASSWORT@localhost:5432/pinario

# Schlüssel, mit dem die OAuth-Token der Kanäle in der Datenbank verschlüsselt
# werden. Erzeugen mit:
#   venv\Scripts\python.exe -m app.tresor neu
# Ändern macht alle gespeicherten Zugänge unlesbar, dann müssen die Kanäle
# neu verbunden werden.
TRESOR_SCHLUESSEL=

# Gemini für die Content-Erzeugung (Text, Bild, später Video).
#
# GEMINI_API_KEY ist hier nur noch der **Rückfall**. Der übliche Weg ist die
# Seite "Einstellungen" in der Anwendung; was dort steht, gilt. So lässt sich
# der Schlüssel wechseln, ohne sich per ssh anzumelden und den Dienst neu zu
# starten. Er liegt dann verschlüsselt in der Datenbank, mit demselben
# Tresor wie die OAuth-Token.
GEMINI_API_KEY=
GEMINI_MODELL_TEXT=gemini-3.7-flash
GEMINI_MODELL_BILD=gemini-3-pro-image-preview

# Unter welcher Adresse die Anwendung von außen erreichbar ist, ohne
# Schrägstrich am Ende. Daraus wird die Rückruf-Adresse jedes Kanals gebaut,
# und sie steht auf der Seite "Einstellungen" zum Abschreiben.
#
# Der Wert kommt bewusst von hier und nicht aus der laufenden Anfrage: bei
# der Plattform ist genau eine Adresse hinterlegt, und über www.pinario.de
# hieße sie sonst plötzlich anders als über pinario.de. Lokal:
#   OEFFENTLICHE_ADRESSE=http://localhost:5001
OEFFENTLICHE_ADRESSE=https://pinario.de

# Pinterest API v5. Die App wird unter developers.pinterest.com angelegt.
# Die Redirect-URI wird dort eingetragen und muss zeichengenau die sein, die
# auf der Seite "Einstellungen" steht.
#
# APP_ID und APP_SECRET sind hier nur noch der **Rückfall**, der übliche Weg
# ist die Seite "Einstellungen". Dasselbe gilt für Google weiter unten.
# Instagram, Facebook und X haben hier gar keinen Platz mehr — für die gibt
# es die Einstellungen und sonst nichts. Bei Facebook und Instagram steht
# dahinter meistens dieselbe Meta-App; eingetragen wird sie trotzdem
# zweimal, weil zwei Kanäle nicht auf ewig eine App teilen müssen.
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=

# Google Business Profile. Anders als bei Pinterest reicht es nicht, ein
# Projekt in der Cloud Console anzulegen: der Zugang zu den
# Business-Profile-APIs muss bei Google gesondert beantragt werden. Vorher
# liefert jeder Aufruf 403, auch wenn hier alles richtig steht.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
